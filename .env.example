# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Local dev default; Fly.io sets this automatically via the Postgres attachment
DATABASE_URL=postgresql://localhost/closeclay

# From your Close OAuth app (https://app.close.com/settings/apps/oauth/)
CLOSE_CLIENT_ID=your_close_client_id_here
CLOSE_CLIENT_SECRET=your_close_client_secret_here

# Local dev
CLOSE_REDIRECT_URI=http://127.0.0.1:5000/auth/close/callback
# Production — update in Fly.io secrets AND in your Close OAuth app settings:
# CLOSE_REDIRECT_URI=https://clay.closekit.com/auth/close/callback

# Set to "true" in production (Fly.io) so cookies are HTTPS-only
SESSION_COOKIE_SECURE=false

# Comma-separated list of Close account emails with access to /admin
ADMIN_EMAILS=you@example.com
